package main

import (
	"bytes"
	"flag"
	"fmt"
	"go/token"
	"io/fs"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
	"time"

	"github.com/effect-go/effect-go/internal/syntax/parser"

	"github.com/effect-go/effect-go/internal/layers"
	"github.com/effect-go/effect-go/internal/lower"
)

func generate(args []string) error {
	fl := flag.NewFlagSet("generate", flag.ExitOnError)
	lines := fl.Bool("lines", true, "add //line directives pointing at the .ego files")
	checkFlag := fl.Bool("check", false, "write nothing; fail if a generated file is missing or stale (for CI)")
	tags := fl.String("tags", "", "build tags to consider satisfied, as go build's -tags")
	fl.Parse(args)
	checkOnly, stale = *checkFlag, false
	if *tags != "" {
		defer setTags(*tags)()
	}
	found := check egoDirs(fl.Args()) ""
	// Leftovers go first: they would compile into the package.
	var dirs []string
	for _, dir := range found {
		check removeLeftovers(dir) ""
		if hasSources(dir) {
			dirs = append(dirs, dir)
		}
	}
	dirs = dependencyOrder(dirs)
	im := lower.NewImporter()
	debug := os.Getenv("EGO_DEBUG") != ""
	start := time.Now()
	check runtimeHint(im.Preload(dirs)) ""
	if debug {
		fmt.Fprintf(os.Stderr, "preload: %v\n", time.Since(start).Round(time.Millisecond))
	}
	// Packages are generated in import order, but an external test may import
	// a package that imports its own: then the first pass can't compile it.
	// Passes repeat while they write something new.
	pending := dirs
	for {
		var failed, report []string
		progress := false
		for _, dir := range pending {
			ok, changed := check generateDir(dir, im, *lines, debug, &report)
			progress = progress || changed
			if !ok {
				failed = append(failed, dir)
			}
		}
		if len(failed) == 0 || !progress || checkOnly {
			for _, line := range report {
				fmt.Fprintln(os.Stderr, line)
			}
			if len(failed) > 0 || stale {
				return errSilent
			}
			return nil
		}
		pending = failed
	}
}

// generateDir writes the Go of the package in dir: all of it, or only the
// package's own when just its tests fail, so the packages that import it
// can compile. It reports whether the package compiled, and whether a file
// changed; its diagnostics go to report.
func generateDir(dir string, im *lower.Importer, lines, debug bool, report *[]string) (ok, changed bool, err error) {
	if layers.HasInjectors(dir) && exists(filepath.Join(dir, "layers.ego")) {
		*report = append(*report, rel(filepath.Join(dir, "layers.ego"))+": the name is taken by the wiring's "+layers.FileName+"; rename it")
		return false, false, nil
	}
	// Files that build constraints exclude here are compiled where they
	// hold, so their Go is current whatever the platform.
	res, err := lower.Generate(lower.Config{Dir: dir, NoLines: !lines, Importer: im, Excluded: _ => true})
	check runtimeHint(err) "{rel(dir)}"
	if debug {
		var phases []string
		for _, ph := range res.Phases {
			phases = append(phases, f"{ph.Name} {ph.Took.Round(time.Millisecond/10)}")
		}
		fmt.Fprintf(os.Stderr, "%s: %s\n", rel(dir), strings.Join(phases, ", "))
	}
	onlyTests := true
	for _, d := range res.Diags {
		*report = append(*report, rel(d.Pos.String())+": "+d.Msg)
		onlyTests = onlyTests && isTest(d.Pos.Filename)
	}
	reportExcluded(res.Excluded, report)
	// Later packages load this one's Go: they must see what was written.
	defer func() {
		if changed {
			im.Forget(dir)
		}
	}()
	for _, out := range res.Outputs {
		if len(res.Diags) == 0 || onlyTests && !isTest(out.Ego) {
			wrote := check write(out.Go, out.Code) ""
			changed = changed || wrote
		}
	}
	if len(res.Diags) > 0 {
		if debug {
			for _, out := range res.Outputs {
				fmt.Fprintf(os.Stderr, "--- %s\n%s\n", out.Go, out.Raw)
			}
		}
		return false, changed, nil
	}
	// Layers are wired after the .ego files compile: injectors may use
	// their declarations.
	lr := check layers.Generate(dir) "{rel(dir)}"
	if lr == nil {
		return true, changed, nil
	}
	for _, d := range lr.Diags {
		*report = append(*report, rel(d.Pos.String())+": "+d.Msg)
	}
	if len(lr.Diags) > 0 {
		return false, changed, nil
	}
	if handWritten(lr.Path) {
		*report = append(*report, rel(lr.Path)+": not generated by ego, which writes the wiring there; rename it")
		return false, changed, nil
	}
	wrote := check write(lr.Path, lr.Code) ""
	return true, changed || wrote, nil
}

// removeLeftovers removes the files ego generate wrote in dir whose source
// is gone (see lower.Leftovers). With -check it only reports them.
func removeLeftovers(dir string) error {
	for _, path := range lower.Leftovers(dir) {
		if checkOnly {
			src, _ := generatedFrom(path)
			why := if src == "" { "no injector" } else { "no " + src }
			fmt.Fprintf(os.Stderr, "%s: %s; run ego generate\n", rel(path), why)
			stale = true
			continue
		}
		check os.Remove(path) ""
		fmt.Println("removed " + rel(path))
	}
	return nil
}

// generatedFrom reports whether ego generate wrote the Go file at path, by
// its first line, and the .ego file it was written from: "" for the wiring,
// layers_ego.go. A header may not name the .ego file, as coverage runs
// rewrite it: then the file's name does.
func generatedFrom(path string) (src string, ok bool) {
	if !strings.HasSuffix(path, ".go") {
		return "", false
	}
	src, ok = lower.GeneratedFrom(path)
	if !ok || src != "" || filepath.Base(path) == layers.FileName {
		return src, ok
	}
	src, _ = lower.SourceName(filepath.Base(path))
	return src, true
}

// reportExcluded reports the .ego files that build constraints exclude in
// every build context ego compiles in, whose Go is stale, which fails, or
// missing, which is only a note.
func reportExcluded(excluded []lower.Excluded, report *[]string) {
	for _, ex := range excluded {
		why := f"no GOOS, GOARCH and build tags that ego compiles for satisfy the build constraints of {filepath.Base(ex.Ego)}"
		where := "generate it where they hold (with GOOS, GOARCH, CGO_ENABLED or ego generate -tags)"
		switch {
		case ex.Stale:
			*report = append(*report, f"{rel(ex.Go)}: stale: {why}, but {filepath.Base(ex.Go)} builds here; {where}")
			stale = true
		case ex.Missing:
			*report = append(*report, f"{rel(ex.Go)}: not generated: {why}; {where}")
		}
	}
}

// setTags adds build tags to GOFLAGS, where go list reads them, and so the
// compiler, and returns a function that restores GOFLAGS.
func setTags(tags string) func() {
	old, had := os.LookupEnv("GOFLAGS")
	list := strings.Join(strings.Fields(strings.ReplaceAll(tags, ",", " ")), ",")
	os.Setenv("GOFLAGS", strings.TrimSpace(old+" -tags="+list))
	return func() {
		if had {
			os.Setenv("GOFLAGS", old)
		} else {
			os.Unsetenv("GOFLAGS")
		}
	}
}

// runtimeHint adds advice to go's "go mod tidy" for a module that lacks the
// requirements of the effect-go runtime: go mod tidy can't see the imports
// of .ego files, and would drop the effect-go requirement instead.
func runtimeHint(err error) error {
	if err == nil || !strings.Contains(err.Error(), "go mod tidy") {
		return err
	}
	var pkgs []string
	for _, p := range []string{"scope", "schedule", "trace", "layer"} {
		pkgs = append(pkgs, f"{modulePath}/{p}@{runtimeVersion()}")
	}
	return fmt.Errorf("%v\nIf the module lacks the requirements of the effect-go runtime, which go mod tidy can't see in .ego files, run instead:\n\tgo get %s", err, strings.Join(pkgs, " "))
}

// runtimeVersion is the version of the runtime that goes with this ego.
func runtimeVersion() string {
	if v := version(); v != "devel" {
		return v
	}
	return "latest"
}

// hasSources reports whether dir has .ego files or layer injectors.
func hasSources(dir string) bool {
	egos, _ := filepath.Glob(filepath.Join(dir, "*.ego"))
	return len(egos) > 0 || layers.HasInjectors(dir)
}

func isTest(name string) bool {
	return strings.HasSuffix(name, "_test.ego") || strings.HasSuffix(name, "_test.go")
}

var stale bool

var checkOnly bool

// write writes a generated file if it changed, prints its name, and
// reports whether it wrote it. With -check it only reports the file as
// stale. It doesn't overwrite a file that ego generate didn't write.
func write(path string, code []byte) (bool, error) {
	if old, _ := os.ReadFile(path); bytes.Equal(old, code) {
		return false, nil
	}
	if handWritten(path) {
		fail "{rel(path)}: not generated by ego, which won't overwrite it; rename it"
	}
	if checkOnly {
		fmt.Fprintln(os.Stderr, rel(path)+": stale; run ego generate")
		stale = true
		return false, nil
	}
	check os.WriteFile(path, code, 0o666) ""
	fmt.Println(rel(path))
	return true, nil
}

// handWritten reports whether there is a file at path that ego generate
// didn't write.
func handWritten(path string) bool {
	_, ok := lower.GeneratedFrom(path)
	return !ok && exists(path)
}

func rel(path string) string {
	wd, _ := os.Getwd()
	if r, err := filepath.Rel(wd, path); err == nil && !strings.HasPrefix(r, "..") {
		return r
	}
	return path
}

// egoDirs returns the directories with .ego files or generated Go that args
// name: directories, dir/... for a tree, .ego files, or import paths, also
// with /....
func egoDirs(args []string) ([]string, error) {
	if len(args) == 0 {
		args = []string{"./..."}
	}
	seen := map[string]bool{}
	var dirs []string
	add := func(d string) {
		if !seen[d] {
			seen[d] = true
			dirs = append(dirs, d)
		}
	}
	var local []string
	for _, a := range args {
		if isLocal(a) {
			local = append(local, a)
			continue
		}
		ds := check importDirs(a) ""
		local = append(local, ds...)
	}
	for _, a := range local {
		if root, ok := strings.CutSuffix(a, "/..."); ok {
			check filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
				check err
				// What go's ./... skips.
				if d.IsDir() && path != root && (strings.HasPrefix(d.Name(), ".") || strings.HasPrefix(d.Name(), "_") || d.Name() == "testdata" || d.Name() == "vendor") {
					return filepath.SkipDir
				}
				if d.IsDir() && path != root && exists(filepath.Join(path, "go.mod")) {
					return filepath.SkipDir // another module, as go's ./... skips it
				}
				if d.IsDir() {
					if layers.HasInjectors(path) {
						add(path)
					}
					return nil
				}
				// A generated file may be left from a deleted .ego file.
				if strings.HasSuffix(path, ".ego") || strings.HasSuffix(path, "_ego.go") || strings.HasSuffix(path, "_ego_test.go") {
					add(filepath.Dir(path))
				}
				return nil
			}) ""
			continue
		}
		fi, err := os.Stat(a)
		switch {
		case err != nil:
			fail "{a}: no such directory or .ego file"
		case fi.IsDir():
			add(a)
		case strings.HasSuffix(a, ".ego"):
			add(filepath.Dir(a))
		default:
			fail "{a}: not a directory or .ego file"
		}
	}
	return dirs, nil
}

// isLocal reports whether a package argument is a path in the file system,
// rather than an import path. As go does, ./x is a path and x an import
// path, but x is a path too if there is such a directory or .ego file.
func isLocal(arg string) bool {
	if arg == "." || arg == ".." || strings.HasPrefix(arg, "./") || strings.HasPrefix(arg, "../") || filepath.IsAbs(arg) {
		return true
	}
	_, err := os.Stat(strings.TrimSuffix(arg, "/..."))
	return err == nil
}

// importDirs returns the directory of the package that an import path
// names, or the tree that path/... does. In the main modules it's found by
// their paths, as a package may have no Go file yet; elsewhere by go list.
func importDirs(pattern string) ([]string, error) {
	path, tree := strings.CutSuffix(pattern, "/...")
	suffix := if tree { "/..." } else { "" }
	out := check exec.Command("go", "list", "-m", "-f", "{{.Path}} {{.Dir}}").Output() "{pattern}: go list -m"
	best, bestDir := "", ""
	for _, line := range strings.Split(strings.TrimSpace(string(out)), "\n") {
		mod, dir, _ := strings.Cut(line, " ")
		if rest, ok := strings.CutPrefix(path, mod); ok && (rest == "" || rest[0] == '/') && len(mod) > len(best) && dir != "" {
			best, bestDir = mod, filepath.Join(dir, filepath.FromSlash(rest))
		}
	}
	if best != "" {
		return []string{bestDir + suffix}, nil
	}
	out = check exec.Command("go", "list", "-e", "-f", "{{.Dir}}", pattern).Output() "{pattern}: go list"
	dirs := strings.Fields(string(out))
	if len(dirs) == 0 {
		fail "{pattern}: no such package"
	}
	return dirs, nil
}

// exists reports whether path exists.
func exists(path string) bool {
	_, err := os.Stat(path)
	return err == nil
}

// dependencyOrder sorts dirs so that a package comes after the packages it
// imports: the compiler type-checks against their generated code.
func dependencyOrder(dirs []string) []string {
	paths := map[string]string{} // import path -> dir
	for _, d := range dirs {
		if p, err := lower.ImportPath(d); err == nil {
			paths[p] = d
		}
	}
	deps := map[string][]string{}
	for _, d := range dirs {
		entries, _ := os.ReadDir(d)
		for _, e := range entries {
			// Tests don't order packages: an external test may import a
			// package that imports its own.
			if !strings.HasSuffix(e.Name(), ".ego") && !strings.HasSuffix(e.Name(), ".go") || isTest(e.Name()) {
				continue
			}
			f, err := parser.ParseFile(token.NewFileSet(), filepath.Join(d, e.Name()), nil, parser.ImportsOnly)
			if err != nil {
				continue
			}
			for _, imp := range f.Imports {
				p, _ := strconv.Unquote(imp.Path.Value)
				if dep, ok := paths[p]; ok && dep != d {
					deps[d] = append(deps[d], dep)
				}
			}
		}
	}
	var out []string
	state := map[string]int{} // 1: visiting, 2: done
	var visit func(d string)
	visit = func(d string) {
		if state[d] != 0 {
			return // done, or an import cycle, which go build reports
		}
		state[d] = 1
		for _, dep := range deps[d] {
			visit(dep)
		}
		state[d] = 2
		out = append(out, d)
	}
	for _, d := range dirs {
		visit(d)
	}
	return out
}
