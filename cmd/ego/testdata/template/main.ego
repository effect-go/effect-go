package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
)

// Config is what the service reads from its environment.
type Config struct {
	Addr string
}

func main() {
	slog.SetDefault(slog.New(trace.LogHandler(slog.NewTextHandler(os.Stderr, nil))))
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	cfg := Config{Addr: os.LookupEnv("ADDR") ?? ":8080"}
	_, err := scope.Run(ctx, s => serve(s, cfg))
	if err != nil {
		slog.Error("stopped", "err", err)
		os.Exit(1)
	}
}

// serve serves HTTP until ctx is cancelled (Ctrl-C or SIGTERM), then lets
// the requests in flight finish. Its ctx comes from the scope.
effect serve(s *scope.Scope, cfg Config) (struct{}, error) {
	srv := check BuildServer(s, cfg)
	context.AfterFunc(ctx, () => srv.Shutdown(context.WithoutCancel(ctx)))
	slog.InfoContext("listening", "addr", cfg.Addr)
	if err := srv.ListenAndServe(); !errors.Is(err, http.ErrServerClosed) {
		return struct{}{}, err
	}
	return struct{}{}, nil
}

func NewServer(cfg Config, h *Handler) *http.Server {
	mux := http.NewServeMux()
	h.Routes(mux)
	return &http.Server{Addr: cfg.Addr, Handler: mux}
}
