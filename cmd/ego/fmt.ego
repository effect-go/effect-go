package main

import (
	"bytes"
	"flag"
	"fmt"
	"io"
	"io/fs"
	"os"
	"path/filepath"
	"strings"

	"github.com/effect-go/effect-go/internal/syntax/format"
)

// fmtCmd formats .ego files as gofmt formats Go: stdin to stdout, a file to
// stdout, or with -l and -w, files and the trees of directories.
func fmtCmd(args []string) error {
	fl := flag.NewFlagSet("fmt", flag.ExitOnError)
	list := fl.Bool("l", false, "list files whose formatting differs")
	write := fl.Bool("w", false, "write the result to the file")
	fl.Parse(args)
	paths := fl.Args()
	if len(paths) == 0 {
		if !*list && !*write {
			src := check io.ReadAll(os.Stdin) ""
			out := check format.Source(src) ""
			check os.Stdout.Write(out) ""
			return nil
		}
		paths = []string{"."}
	}
	failed := false
	for _, root := range paths {
		root = strings.TrimSuffix(root, "/...")
		fi := check os.Stat(root) ""
		if fi.IsDir() && !*list && !*write {
			fail "{root} is a directory: use -l to list the files to format, -w to format them"
		}
		check filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
			check err
			if d.IsDir() {
				if path != root && (strings.HasPrefix(d.Name(), ".") || d.Name() == "vendor" || d.Name() == "testdata") {
					return filepath.SkipDir
				}
				return nil
			}
			if path != root && !strings.HasSuffix(path, ".ego") {
				return nil
			}
			if err := fmtFile(path, *list, *write); err != nil {
				fmt.Fprintln(os.Stderr, err)
				failed = true
			}
			return nil
		}) ""
	}
	if failed {
		return errSilent
	}
	return nil
}

// fmtFile formats one file: it lists it, rewrites it, or else prints it.
func fmtFile(path string, list, write bool) error {
	src := check os.ReadFile(path) ""
	out, err := format.Source(src)
	if err != nil {
		return fmt.Errorf("%s:%v", path, err) // path:line:col: message
	}
	if !list && !write {
		check os.Stdout.Write(out) ""
		return nil
	}
	if bytes.Equal(src, out) {
		return nil
	}
	if list {
		fmt.Println(path)
	}
	if write {
		check os.WriteFile(path, out, 0o666) ""
	}
	return nil
}
