package main

import (
	"errors"
	"fmt"
	"io"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
)

// Store keeps the todos. Its methods are effect methods: they take a ctx,
// which callers in effect functions pass without writing it.
type Store interface {
	effect Insert(t Todo) (Todo, error)
	effect List() ([]Todo, error)
	effect Complete(id int64, at time.Time) (found bool, err error)
	effect Delete(id int64) (found bool, err error)
	effect Count(f Filter, now time.Time) (int, error)
}

// Filter selects todos to count.
enum Filter {
	Open
	Done
	Overdue
}

// PgStore is the PostgreSQL store.
type PgStore struct{ db *pgxpool.Pool }

func NewPgStore(db *pgxpool.Pool) *PgStore { return &PgStore{db} }

const schema = `CREATE TABLE IF NOT EXISTS todos (
	id         bigserial PRIMARY KEY,
	title      text NOT NULL,
	priority   int NOT NULL DEFAULT 0,
	due        date,
	done_at    timestamptz,
	created_at timestamptz NOT NULL DEFAULT now()
)`

// connectRetry retries a failed connection: the database may still be
// starting, as with docker compose. A bad URL won't get better, so it isn't
// retried.
var connectRetry = schedule.Max(schedule.Exponential(200*time.Millisecond), schedule.Recurs(4)).
	Jittered().
	While(err => !errors.Is(err, errBadURL))

var errBadURL = errors.New("bad database URL")

// Connect opens the pool, waiting for the database, and creates the table.
effect Connect(cfg Config) (*pgxpool.Pool, error) {
	w := cfg.Err ?? io.Discard
	policy := connectRetry.Tap((n, err, wait) => fmt.Fprintln(w, f"waiting for the database (attempt {n + 1} in {wait.Round(time.Millisecond)})"))
	db := check retry(policy, open(cfg.DatabaseURL)) "connect to the database"
	check db.Exec(schema) "create the todos table"
	return db, nil
}

effect open(url string) (*pgxpool.Pool, error) {
	pc, err := pgxpool.ParseConfig(url)
	if err != nil {
		return nil, errors.Join(errBadURL, err)
	}
	db := check pgxpool.NewWithConfig(pc)
	if err := db.Ping(); err != nil {
		db.Close()
		return nil, err
	}
	return db, nil
}

effect (s *PgStore) Insert(t Todo) (Todo, error) {
	row := s.db.QueryRow(`INSERT INTO todos (title, priority, due) VALUES ($1, $2, $3) RETURNING id, created_at`, t.Title, t.Priority, t.Due)
	check row.Scan(&t.ID, &t.CreatedAt)
	return t, nil
}

effect (s *PgStore) List() ([]Todo, error) {
	rows := check s.db.Query(`SELECT id, title, priority, due, done_at, created_at FROM todos`)
	return pgx.CollectRows(rows, pgx.RowToStructByName[Todo])
}

// Complete marks a todo done. One already done keeps its first time.
effect (s *PgStore) Complete(id int64, at time.Time) (bool, error) {
	return s.found(`UPDATE todos SET done_at = coalesce(done_at, $2) WHERE id = $1 RETURNING true`, id, at)
}

effect (s *PgStore) Delete(id int64) (bool, error) {
	return s.found(`DELETE FROM todos WHERE id = $1 RETURNING true`, id)
}

// found runs a statement that returns a row for the todo it changed, and
// reports whether there was one.
effect (s *PgStore) found(sql string, args ...any) (bool, error) {
	rows := check s.db.Query(sql, args...)
	found := check pgx.CollectExactlyOneRow(rows, pgx.RowTo[bool]) else { pgx.ErrNoRows => false }
	return found, nil
}

effect (s *PgStore) Count(f Filter, now time.Time) (int, error) {
	where := match f {
		Open    => "done_at IS NULL"
		Done    => "done_at IS NOT NULL"
		Overdue => "done_at IS NULL AND due < $1::date"
	}
	var n int
	args := if f == Overdue { []any{now} } else { nil }
	check s.db.QueryRow(`SELECT count(*) FROM todos WHERE `+where, args...).Scan(&n)
	return n, nil
}
