package main

import (
	"context"
	"os"
	"os/signal"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	code, err := scope.Run(ctx, s => run(s, os.Args[1:]))
	stop()
	os.Exit(if err != nil { Report(os.Stderr, err) } else { code })
}

// run parses the command line before anything connects, then builds the app
// in s, with the generated BuildCLI, and runs the command. The scope closes
// the database pool when it ends.
effect run(s *scope.Scope, args []string) (int, TodoError) {
	cmd := check ParseArgs(args)
	cli := check BuildCLI(s, Config{DatabaseURL: databaseURL(), Out: os.Stdout, Err: os.Stderr}) as Storage
	return cli.Run(cmd), nil
}
