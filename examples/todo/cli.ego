package main

import (
	"fmt"
	"io"
	"time"
)

// Config is what the app needs from its environment.
type Config struct {
	DatabaseURL string
	Out, Err    io.Writer
}

// CLI runs commands.
type CLI struct {
	svc      *Service
	now      Clock
	out, err io.Writer
}

func NewCLI(svc *Service, now Clock, cfg Config) *CLI { return &CLI{svc, now, cfg.Out, cfg.Err} }

// Run runs a command, gives it 10 seconds, and returns the exit code.
effect (c *CLI) Run(cmd Command) int {
	_, err := timeout(10*time.Second, c.run(cmd))
	return Report(c.err, err)
}

effect (c *CLI) run(cmd Command) error {
	match cmd.Action {
		Add => {
			t := check c.svc.Add(cmd.Title, cmd.Priority, cmd.Due)
			fmt.Fprintln(c.out, f"added #{t.ID}: {t.Title}")
		}
		List      => check c.list(cmd.All)
		Complete  => check c.svc.Done(cmd.ID)
		Remove    => check c.svc.Remove(cmd.ID)
		ShowStats => {
			s := check c.svc.Stats()
			fmt.Fprintln(c.out, f"{s.Open} open, {s.Done} done, {s.Overdue} overdue")
		}
	}
	return nil
}

effect (c *CLI) list(all bool) error {
	todos := check c.svc.List(all)
	if len(todos) == 0 {
		fmt.Fprintln(c.out, "nothing to do")
	}
	now := c.now()
	for _, t := range todos {
		mark := if t.DoneAt != nil { "x" } else { " " }
		due := t.Due?.Format(time.DateOnly) ?? ""
		if t.Overdue(now) {
			due += " (overdue)"
		}
		fmt.Fprintln(c.out, f"[{mark}] #{t.ID:-3d} {t.Priority:-6s} {t.Title}  {due}")
	}
	return nil
}
