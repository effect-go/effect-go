package users

import (
	"fmt"
	"net/http"
	"time"
)

type UserID string

type User struct {
	ID             UserID
	Name           string
	SuspendedUntil time.Time
}

// Repo looks users up in storage.
type Repo interface {
	effect Find(id UserID) (user User, found bool, err error)
}

// UserError is every way Service.Get can fail.
error UserError {
	NotFound{ ID UserID } "no user {ID}"
	Suspended{ Until time.Time }
	Storage{ Cause error }
}

type Service struct {
	Repo Repo
	Now  func() time.Time
}

// Get returns the user id, unless it is missing or suspended.
effect (s *Service) Get(id UserID) (User, UserError) {
	u, found := check s.Repo.Find(id) as Storage
	if !found {
		fail NotFound{ID: id}
	}
	if u.SuspendedUntil.After(s.Now()) {
		fail Suspended{Until: u.SuspendedUntil}
	}
	return u, nil
}

type Handler struct{ Users *Service }

// GetUser serves GET /users/{id}.
func (h *Handler) GetUser(w http.ResponseWriter, r *http.Request) {
	id := UserID(r.PathValue("id"))
	u, err := h.Users.Get(r.Context(), id)
	match err {
		nil          => fmt.Fprintln(w, u.Name)
		NotFound(e)  => http.Error(w, f"no user {e.ID}", http.StatusNotFound)
		Suspended(e) => http.Error(w, f"suspended until {e.Until.Format("2006-01-02")}", http.StatusForbidden)
		Storage(_)   => http.Error(w, "try again later", http.StatusServiceUnavailable)
	}
}
