package dashboard

import (
	"errors"
	"time"
)

effect Load(d Deps, id string) (Page, error) {
	return timeout(2*time.Second, loadPage(d, id))
}

effect loadPage(d Deps, id string) (Page, error) {
	policy := schedule.Max(
		schedule.Exponential(100*time.Millisecond).Jittered(),
		schedule.Recurs(3),
	).While((err error) => !errors.Is(err, ErrRejected))

	user, orders, recs := check all(
		d.Users.Get(id),
		d.Orders.ForUser(id),
		retry(policy, d.Recs.For(id)),
	)
	banner := check race(d.CDN.Primary(user.Banner), d.CDN.Mirror(user.Banner)) "banner"
	return Page{User: user, Orders: orders, Recs: recs, Banner: banner}, nil
}
