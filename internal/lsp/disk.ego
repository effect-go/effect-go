package lsp

import (
	"fmt"
	"go/scanner"
	"go/token"
	"os"
	"path/filepath"
	"slices"
	"sort"
	"strings"

	"github.com/effect-go/effect-go/internal/lower"
)

// The generated files of a directory where the editor has no .ego file
// open aren't buffers in gopls: gopls reads them from disk, and a result
// that lands there, as a definition in another package does, is at a
// position in the formatted Go that ego generate wrote. The proxy compiles
// such a directory when a result lands in it, for the source maps, and
// keeps them until the directory's files change.

// diskDir holds the documents of a directory's generated files on disk.
type diskDir struct {
	stamp string             // of the directory's files when compiled
	docs  map[string]*genDoc // by generated URI: the files that are the Go of their .ego files
}

// maxDiskDirs bounds the directories whose source maps the proxy keeps.
const maxDiskDirs = 64

// docOf returns the document of a generated URI in a result: its buffer in
// gopls, or else the file gopls reads from disk, if it is the Go of its .ego
// file. It returns nil for a hand-written Go file, whose positions stay as
// they are, and for generated Go that the proxy can't map: stale, say.
func (p *Proxy) docOf(uri string) *genDoc {
	if g := p.genOf(uri); g != nil {
		return g
	}
	path := uriToPath(uri)
	if !strings.HasSuffix(path, ".go") || !filepath.IsAbs(path) {
		return nil
	}
	if _, ok := lower.GeneratedFrom(path); !ok {
		return nil
	}
	dir := filepath.Dir(path)
	stamp := dirStamp(dir)
	p.diskMu.Lock()
	defer p.diskMu.Unlock()
	d := p.disk[dir]
	if d == nil || d.stamp != stamp {
		d = &diskDir{stamp: stamp, docs: p.diskDocs(dir)}
		if len(p.disk) >= maxDiskDirs {
			for k := range p.disk {
				delete(p.disk, k)
				break
			}
		}
		p.disk[dir] = d
	}
	return d.docs[canon(uri)]
}

// dirStamp returns the names, sizes and modification times of the files in
// dir: they change when one of its files does.
func dirStamp(dir string) string {
	entries, _ := os.ReadDir(dir)
	var b strings.Builder
	for _, e := range entries {
		if fi, err := e.Info(); err == nil {
			fmt.Fprintf(&b, "%s %d %d\n", e.Name(), fi.Size(), fi.ModTime().UnixNano())
		}
	}
	return b.String()
}

// diskDocs compiles the package in dir from its files, and returns the
// documents of the generated files that hold its Go, up to formatting and
// comments: ego generate -lines=false leaves out the //line directives.
func (p *Proxy) diskDocs(dir string) map[string]*genDoc {
	docs := map[string]*genDoc{}
	res, err := lower.Generate(lower.Config{Dir: dir, Importer: p.im, NoTypeCheck: true})
	if err != nil {
		p.logf("source maps of %s: %v", dir, err)
		return docs
	}
	for _, out := range res.Outputs {
		text, err := os.ReadFile(out.Go)
		if err != nil {
			continue
		}
		toks := tokens(text)
		if !slices.EqualFunc(toks, tokens(out.Code), (a, b) => a.key == b.key) {
			continue // stale
		}
		uri := pathToURI(out.Go)
		docs[uri] = &genDoc{uri: uri, egoURI: pathToURI(out.Ego), out: out, disk: align(text, toks, tokens(out.Raw))}
	}
	return docs
}

// An alignment maps offsets in a generated file on disk to the Go before
// formatting, which the source map describes, by pairing their tokens:
// formatting changes the space between tokens, sorts imports and drops some
// parentheses.
type alignment struct {
	text  []byte // the file on disk
	pairs []pair // by offset
}

// pair is a token at offset disk on disk and raw before formatting, n bytes
// long.
type pair struct{ disk, raw, n int }

// tok is a token of Go source: its offset, length and text.
type tok struct {
	off, n int
	key    string
}

// tokens returns the tokens of Go source but comments and semicolons, which
// formatting adds and removes.
func tokens(src []byte) []tok {
	fset := token.NewFileSet()
	f := fset.AddFile("", -1, len(src))
	var s scanner.Scanner
	s.Init(f, src, nil, 0)
	var toks []tok
	for {
		pos, t, lit := s.Scan()
		if t == token.EOF {
			return toks
		}
		if t == token.SEMICOLON {
			continue
		}
		key := lit
		switch {
		case lit == "":
			key = t.String()
		case t == token.INT || t == token.FLOAT || t == token.IMAG:
			key = strings.ToLower(lit) // formatting lowers 0X and 1E
		}
		toks = append(toks, tok{off: f.Offset(pos), n: len(key), key: key})
	}
}

// align pairs the tokens of a file on disk and of its Go before formatting.
// Past a difference, they pair again from where three tokens in a row match.
func align(text []byte, disk, raw []tok) *alignment {
	a := &alignment{text: text}
	i, j := 0, 0
	for i < len(disk) && j < len(raw) {
		if disk[i].key == raw[j].key {
			a.pairs = append(a.pairs, pair{disk[i].off, raw[j].off, disk[i].n})
			i, j = i+1, j+1
			continue
		}
		var ok bool
		if i, j, ok = resync(disk, raw, i, j); !ok {
			break
		}
	}
	return a
}

// resync returns the nearest positions past i and j where three tokens in a
// row match, or the ends.
func resync(a, b []tok, i, j int) (int, int, bool) {
	for d := 1; d <= 64; d++ {
		for k := 0; k <= d; k++ {
			if same(a, b, i+k, j+d-k) {
				return i + k, j + d - k, true
			}
		}
	}
	return i, j, false
}

// same reports whether three tokens match from i and j, or the rest of
// both if shorter.
func same(a, b []tok, i, j int) bool {
	for k := 0; k < 3; k++ {
		if i+k >= len(a) || j+k >= len(b) {
			return i+k >= len(a) && j+k >= len(b)
		}
		if a[i+k].key != b[j+k].key {
			return false
		}
	}
	return true
}

// toRaw maps an offset in the file on disk to the Go before formatting.
// exact is false outside the tokens paired. The end of a range prefers the
// token that ends at off to the one that starts there.
func (a *alignment) toRaw(off int, end bool) (raw int, exact bool) {
	ps := a.pairs
	i := sort.Search(len(ps), func(i int) bool { return ps[i].disk > off }) - 1
	if end && i > 0 && ps[i].disk == off && ps[i-1].disk+ps[i-1].n == off {
		i--
	}
	if i < 0 {
		return 0, false
	}
	pr := ps[i]
	if off <= pr.disk+pr.n {
		return pr.raw + off - pr.disk, true
	}
	return pr.raw + pr.n, false
}
