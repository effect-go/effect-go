// Package lsp is a language server for .ego files. It sits between the
// editor and gopls: it compiles each .ego file to Go in memory, gives gopls
// the generated Go as unsaved buffers, and translates positions both ways
// with the compiler's source maps. Formatting is done by ego fmt.
//
// The editor keeps using its own gopls for .go files; this server only
// handles .ego documents (templ's architecture).
package lsp

import (
	"encoding/json"
	"errors"
	"fmt"
	goparser "go/parser"
	"go/token"
	"io"
	"net/url"
	"os"
	"os/exec"
	"path/filepath"
	"runtime/debug"
	"sort"
	"strings"
	"sync"
	"time"
	"unicode/utf8"

	"github.com/effect-go/effect-go/internal/layers"
	"github.com/effect-go/effect-go/internal/lower"
	"github.com/effect-go/effect-go/internal/syntax/format"
)

// Config configures the proxy.
type Config struct {
	Gopls string    // path to gopls; "gopls" if empty
	Log   io.Writer // debug log; may be nil
}

type egoDoc struct {
	uri  string // as the editor writes it
	path string
	text []byte
}

// genDoc is a generated file, open in gopls as an unsaved buffer.
type genDoc struct {
	uri     string
	egoURI  string
	out     *lower.Output
	version int
}

type pending struct {
	method string
	gen    *genDoc
}

// Proxy is the language server. Its maps are keyed by canonical URIs (see
// canon): editors escape file URIs in their own ways.
type Proxy struct {
	cfg    Config
	editor *conn
	gopls  *conn

	regenMu sync.Mutex // one compilation at a time, so gopls sees versions in order

	mu       sync.Mutex             // guards the fields below, and genDoc.out and version
	egos     map[string]*egoDoc     // by .ego URI
	gens     map[string]*genDoc     // by generated URI
	byEgo    map[string]*genDoc     // .ego URI -> generated
	masked   map[string]string      // leftover generated files, open in gopls without their code -> directory
	pending  map[string]pending     // requests forwarded to gopls, by id
	egoDiags map[string][]any       // .ego URI -> compiler diagnostics
	goDiags  map[string][]any       // .ego URI -> gopls diagnostics, mapped
	dirty    map[string]*time.Timer // directories with edits not compiled yet
	im       *lower.Importer
}

// debounce is how long the proxy waits after an edit before compiling. A
// request about the file compiles at once.
const debounce = 150 * time.Millisecond

// requestFailed is LSP's error code for a request that is valid but failed.
const requestFailed = -32803

// Run serves one editor connection until it closes or sends exit.
func Run(cfg Config, in io.Reader, out io.Writer) error {
	gopls := cfg.Gopls
	if gopls == "" {
		gopls = "gopls"
	}
	cmd := exec.Command(gopls)
	cmd.Stderr = os.Stderr
	if cfg.Log != nil {
		cmd.Stderr = cfg.Log
	}
	gin := check cmd.StdinPipe() ""
	gout := check cmd.StdoutPipe() ""
	check cmd.Start() "starting gopls"
	p := newProxy(cfg, newConn(in, out), newConn(gout, gin))
	done := make(chan error, 2)
	go func() { done <- p.fromGopls() }()
	go func() { done <- p.fromEditor() }()
	err := <-done
	gin.Close()
	cmd.Wait()
	if err == io.EOF {
		return nil
	}
	return err
}

func newProxy(cfg Config, editor, gopls *conn) *Proxy {
	p := &Proxy{
		cfg: cfg, editor: editor, gopls: gopls,
		egos: map[string]*egoDoc{}, gens: map[string]*genDoc{}, byEgo: map[string]*genDoc{}, masked: map[string]string{},
		pending: map[string]pending{}, egoDiags: map[string][]any{}, goDiags: map[string][]any{},
		dirty: map[string]*time.Timer{}, im: lower.NewImporter(),
	}
	if os.Getenv("EGO_LSP_TRACE") != "" && cfg.Log != nil {
		p.editor.name, p.editor.log = "editor", cfg.Log
		p.gopls.name, p.gopls.log = "gopls", cfg.Log
	}
	return p
}

func (p *Proxy) logf(format string, args ...any) {
	if p.cfg.Log != nil {
		fmt.Fprintf(p.cfg.Log, "ego lsp: "+format+"\n", args...)
	}
}

func isEgo(uri string) bool { return strings.HasSuffix(uri, ".ego") }

func uriToPath(uri string) string {
	u, err := url.Parse(uri)
	if err != nil || u.Scheme != "file" {
		return uri
	}
	return filepath.FromSlash(u.Path)
}

func pathToURI(path string) string {
	return (&url.URL{Scheme: "file", Path: filepath.ToSlash(path)}).String()
}

// canon returns the form of a file URI that the proxy's maps use: editors
// escape characters that Go doesn't, as VS Code writes at%40dir for at@dir.
func canon(uri string) string {
	if !strings.HasPrefix(uri, "file:") {
		return uri
	}
	return pathToURI(uriToPath(uri))
}

// editorURI returns a .ego URI as the editor wrote it, if it has the file
// open. p.mu must be held.
func (p *Proxy) editorURI(uri string) string {
	if d := p.egos[uri]; d != nil {
		return d.uri
	}
	return uri
}

// genOf returns the generated document of a URI, or nil.
func (p *Proxy) genOf(uri string) *genDoc {
	p.mu.Lock()
	defer p.mu.Unlock()
	return p.gens[canon(uri)]
}

// fromEditor handles messages from the editor.
func (p *Proxy) fromEditor() error {
	for {
		m, err := p.editor.read()
		if bad := (badMessage{}); errors.As(err, &bad) {
			// The next message may be fine.
			p.logf("from the editor: %v", err)
			p.editor.replyError(json.RawMessage("null"), -32700, err.Error())
			continue
		}
		check err
		if err := p.safely(m, m.isRequest(), p.handleEditor); err != nil {
			p.logf("%s: %v", m.Method, err)
		}
		if m.Method == "exit" {
			return io.EOF
		}
	}
}

// safely handles a message, turning a panic into an error, and into an
// error reply to the editor if reply is set: one bad message mustn't end
// the session.
func (p *Proxy) safely(m *message, reply bool, handle func(*message) error) (err error) {
	defer func() {
		if r := recover(); r != nil {
			err = fmt.Errorf("panic: %v\n%s", r, debug.Stack())
			if reply {
				p.editor.replyError(m.ID, -32603, fmt.Sprint("ego lsp: ", r))
			}
		}
	}()
	return handle(m)
}

type docParams struct {
	TextDocument struct {
		URI     string `json:"uri"`
		Version int    `json:"version"`
		Text    string `json:"text"`
	} `json:"textDocument"`
	ContentChanges []struct {
		Range *Range `json:"range"`
		Text  string `json:"text"`
	} `json:"contentChanges"`
}

func (p *Proxy) handleEditor(m *message) error {
	if m.isResponse() {
		return p.gopls.write(m)
	}
	var dp docParams
	json.Unmarshal(m.Params, &dp)
	uri := dp.TextDocument.URI
	switch {
	case m.Method == "initialize":
		m.Params = utf16Only(m.Params)
		p.track(m.ID, pending{method: m.Method})
		return p.gopls.write(m)
	case m.Method == "workspace/didChangeWatchedFiles":
		p.watched(m.Params)
		return p.gopls.write(m)
	case !isEgo(uri):
		return p.gopls.write(m)
	}
	key, path := canon(uri), uriToPath(uri)
	dir := filepath.Dir(path)
	switch m.Method {
	case "textDocument/didOpen":
		p.mu.Lock()
		p.egos[key] = &egoDoc{uri: uri, path: path, text: []byte(dp.TextDocument.Text)}
		p.mu.Unlock()
		return p.regen(dir)
	case "textDocument/didChange":
		p.mu.Lock()
		d := p.egos[key]
		if d == nil {
			p.mu.Unlock()
			return nil
		}
		for _, c := range dp.ContentChanges {
			if c.Range == nil {
				d.text = []byte(c.Text)
				continue
			}
			t := newText(d.text)
			a, b := t.offset(c.Range.Start), t.offset(c.Range.End)
			b = max(a, b)
			d.text = append(append(append([]byte(nil), d.text[:a]...), c.Text...), d.text[b:]...)
		}
		p.mu.Unlock()
		p.schedule(dir)
		return nil
	case "textDocument/didSave":
		check p.flush(dir) ""
		return p.save(dir)
	case "textDocument/didClose":
		return p.close(key)
	case "textDocument/formatting":
		return p.format(m, key)
	}
	if !m.isRequest() {
		return nil // other notifications about .ego files
	}
	if err := p.flush(dir); err != nil {
		p.logf("compile: %v", err)
	}
	p.mu.Lock()
	gen := p.byEgo[key]
	d := p.egos[key]
	var out *lower.Output
	var text []byte
	if gen != nil && d != nil {
		out, text = gen.out, d.text
	}
	p.mu.Unlock()
	if out == nil {
		return p.editor.reply(m.ID, nil)
	}
	params, err := p.toGen(m.Params, text, gen.uri, out)
	if err != nil {
		return p.editor.reply(m.ID, nil)
	}
	p.track(m.ID, pending{method: m.Method, gen: gen})
	return p.gopls.write(&message{ID: m.ID, Method: m.Method, Params: params})
}

// utf16Only removes the position encodings the editor offers from the
// params of initialize: gopls then counts in UTF-16, as the proxy does.
func utf16Only(raw json.RawMessage) json.RawMessage {
	var v map[string]any
	if json.Unmarshal(raw, &v) != nil {
		return raw
	}
	caps, _ := v["capabilities"].(map[string]any)
	general, _ := caps["general"].(map[string]any)
	if _, ok := general["positionEncodings"]; !ok {
		return raw
	}
	delete(general, "positionEncodings")
	out := must json.Marshal(v)
	return out
}

// watched compiles again the directories, among those with buffers in
// gopls, where files changed on disk: the buffers of .ego files the editor
// hasn't open come from their files.
func (p *Proxy) watched(raw json.RawMessage) {
	var params struct {
		Changes []struct {
			URI string `json:"uri"`
		} `json:"changes"`
	}
	json.Unmarshal(raw, &params)
	dirs := map[string]bool{}
	p.mu.Lock()
	for _, c := range params.Changes {
		dir := filepath.Dir(uriToPath(c.URI))
		for u := range p.gens {
			if filepath.Dir(uriToPath(u)) == dir {
				dirs[dir] = true
			}
		}
	}
	p.mu.Unlock()
	for dir := range dirs {
		p.schedule(dir)
	}
}

func (p *Proxy) track(id json.RawMessage, pd pending) {
	p.mu.Lock()
	p.pending[string(id)] = pd
	p.mu.Unlock()
}

// schedule compiles dir after a pause in editing.
func (p *Proxy) schedule(dir string) {
	p.mu.Lock()
	defer p.mu.Unlock()
	if t := p.dirty[dir]; t != nil {
		t.Reset(debounce)
		return
	}
	p.dirty[dir] = time.AfterFunc(debounce, func() {
		if err := p.flush(dir); err != nil {
			p.logf("compile: %v", err)
		}
	})
}

// flush compiles dir now if it has edits not compiled yet. It holds
// regenMu from the start, so it also waits for a compilation in progress:
// a request must not map positions with the source map of older text.
func (p *Proxy) flush(dir string) error {
	p.regenMu.Lock()
	defer p.regenMu.Unlock()
	p.mu.Lock()
	t := p.dirty[dir]
	delete(p.dirty, dir)
	p.mu.Unlock()
	if t == nil {
		return nil
	}
	t.Stop()
	return p.regenLocked(dir)
}

// close forgets a .ego document and its diagnostics. Once the last of a
// directory is closed, gopls closes the buffers of the directory, and
// reads its files from disk again; until then, the document's buffer goes
// back to its file's text.
func (p *Proxy) close(key string) error {
	p.regenMu.Lock()
	defer p.regenMu.Unlock()
	p.mu.Lock()
	uri := p.editorURI(key)
	delete(p.egos, key)
	delete(p.egoDiags, key)
	delete(p.goDiags, key)
	dir := filepath.Dir(uriToPath(key))
	open := false
	for _, d := range p.egos {
		open = open || filepath.Dir(d.path) == dir
	}
	var closed, cleared []string
	if !open {
		for u, g := range p.gens {
			if filepath.Dir(uriToPath(u)) == dir {
				closed = append(closed, u)
				if g.egoURI != key {
					cleared = append(cleared, g.egoURI)
				}
				delete(p.gens, u)
				delete(p.byEgo, g.egoURI)
				delete(p.egoDiags, g.egoURI)
				delete(p.goDiags, g.egoURI)
			}
		}
		for u, d := range p.masked {
			if d == dir {
				closed = append(closed, u)
				delete(p.masked, u)
			}
		}
		if t := p.dirty[dir]; t != nil {
			t.Stop()
			delete(p.dirty, dir)
		}
	}
	p.mu.Unlock()
	sort.Strings(closed)
	for _, u := range closed {
		check p.gopls.notify("textDocument/didClose", map[string]any{"textDocument": map[string]any{"uri": u}}) ""
	}
	for _, u := range append(cleared, uri) {
		check p.editor.notify("textDocument/publishDiagnostics", map[string]any{"uri": u, "diagnostics": []any{}}) ""
	}
	if open {
		return p.regenLocked(dir)
	}
	return nil
}

// regen compiles the package in dir with the open .ego files, and updates
// gopls's buffers and the diagnostics.
func (p *Proxy) regen(dir string) error {
	p.regenMu.Lock()
	defer p.regenMu.Unlock()
	return p.regenLocked(dir)
}

// regenLocked is regen, with regenMu held.
func (p *Proxy) regenLocked(dir string) error {
	p.mu.Lock()
	overlay := map[string][]byte{}
	for _, d := range p.egos {
		if filepath.Dir(d.path) == dir {
			overlay[d.path] = d.text
		}
	}
	p.mu.Unlock()
	res, err := lower.Generate(lower.Config{Dir: dir, Overlay: overlay, Importer: p.im, NoLines: true, NoTypeCheck: true})
	if err != nil {
		// The open files show it: they can't have other diagnostics.
		for path := range overlay {
			uri := pathToURI(path)
			p.mu.Lock()
			p.egoDiags[uri] = []any{map[string]any{"range": Range{}, "severity": 1, "source": "ego", "message": err.Error()}}
			p.mu.Unlock()
			p.publish(uri)
		}
		return err
	}
	byFile := map[string][]any{}
	for path := range overlay {
		byFile[pathToURI(path)] = []any{}
	}
	for _, d := range res.Diags {
		uri := pathToURI(d.Pos.Filename)
		byFile[uri] = append(byFile[uri], p.egoDiag(uri, d))
	}
	p.mu.Lock()
	for uri, ds := range byFile {
		p.egoDiags[uri] = ds
	}
	var notes []func() error
	for _, out := range res.Outputs {
		uri := pathToURI(out.Go)
		egoURI := pathToURI(out.Ego)
		gen := p.gens[uri]
		first := gen == nil
		if first {
			gen = &genDoc{uri: uri, egoURI: egoURI}
			p.gens[uri] = gen
			p.byEgo[egoURI] = gen
		}
		if !first && string(gen.out.Raw) == string(out.Raw) {
			gen.out = out
			continue
		}
		gen.out = out
		gen.version++
		text, version := string(out.Raw), gen.version
		if first {
			notes = append(notes, p.openNote(uri, version, text))
		} else {
			notes = append(notes, func() error {
				return p.gopls.notify("textDocument/didChange", map[string]any{
					"textDocument":   map[string]any{"uri": uri, "version": version},
					"contentChanges": []any{map[string]any{"text": text}},
				})
			})
		}
	}
	notes = append(notes, p.maskLeftovers(dir, res.Leftovers)...)
	var uris []string
	for uri := range byFile {
		uris = append(uris, uri)
	}
	p.mu.Unlock()
	for _, n := range notes {
		check n() ""
	}
	for _, uri := range uris {
		p.publish(uri)
	}
	return nil
}

func (p *Proxy) openNote(uri string, version int, text string) func() error {
	return func() error {
		return p.gopls.notify("textDocument/didOpen", map[string]any{
			"textDocument": map[string]any{"uri": uri, "languageId": "go", "version": version, "text": text},
		})
	}
}

// maskLeftovers opens in gopls, as empty files of the package, the
// generated files left from .ego files that are gone, until ego generate
// removes them: gopls would see their declarations twice. It returns the
// notifications to send. p.mu must be held.
func (p *Proxy) maskLeftovers(dir string, leftovers []string) []func() error {
	var notes []func() error
	want := map[string]bool{}
	for _, path := range leftovers {
		uri := pathToURI(path)
		want[uri] = true
		if _, ok := p.masked[uri]; ok {
			continue
		}
		f, err := goparser.ParseFile(token.NewFileSet(), path, nil, goparser.PackageClauseOnly)
		if err != nil {
			continue
		}
		p.masked[uri] = dir
		notes = append(notes, p.openNote(uri, 1, "package "+f.Name.Name+"\n"))
	}
	for uri, d := range p.masked {
		if d == dir && !want[uri] {
			delete(p.masked, uri)
			notes = append(notes, func() error {
				return p.gopls.notify("textDocument/didClose", map[string]any{"textDocument": map[string]any{"uri": uri}})
			})
		}
	}
	return notes
}

// save removes the files left in dir from .ego files that are gone, as ego
// generate does, then writes the generated files of dir, if it compiled
// cleanly. Leftovers go first: where the file system ignores case, the Go
// of a file renamed in case only would be written under its old name.
func (p *Proxy) save(dir string) error {
	removed := check removeLeftovers(dir) ""
	check p.unmask(removed) ""
	res := check lower.Generate(lower.Config{Dir: dir, Importer: p.im}) ""
	if len(res.Diags) > 0 {
		return nil
	}
	for _, out := range res.Outputs {
		if old, _ := os.ReadFile(out.Go); string(old) == string(out.Code) {
			continue
		}
		check os.WriteFile(out.Go, out.Code, 0o666) ""
	}
	return nil
}

// removeLeftovers removes the files ego generate wrote in dir whose source
// is gone, by ego generate's rules: x_ego.go once x.ego is deleted or
// renamed, if only in case, layers_ego.go once no injector is left. It
// returns their paths.
func removeLeftovers(dir string) ([]string, error) {
	entries, _ := os.ReadDir(dir)
	names := map[string]bool{} // exact: the file system may ignore case
	for _, e := range entries {
		names[e.Name()] = true
	}
	var removed []string
	for _, e := range entries {
		name := e.Name()
		path := filepath.Join(dir, name)
		if !strings.HasSuffix(name, ".go") {
			continue
		}
		leftover := lower.Leftover(dir, name, names)
		if src, ok := lower.GeneratedFrom(path); ok && src == "" && name == layers.FileName {
			leftover = !layers.HasInjectors(dir)
		}
		if !leftover {
			continue
		}
		check os.Remove(path) ""
		removed = append(removed, path)
	}
	return removed, nil
}

// unmask closes the empty buffers that gopls has of removed files.
func (p *Proxy) unmask(paths []string) error {
	var closed []string
	p.mu.Lock()
	for _, path := range paths {
		uri := pathToURI(path)
		if _, ok := p.masked[uri]; ok {
			delete(p.masked, uri)
			closed = append(closed, uri)
		}
	}
	p.mu.Unlock()
	for _, uri := range closed {
		check p.gopls.notify("textDocument/didClose", map[string]any{"textDocument": map[string]any{"uri": uri}}) ""
	}
	return nil
}

// publish sends the diagnostics of a .ego file: the compiler's and gopls's.
func (p *Proxy) publish(uri string) {
	p.mu.Lock()
	all := append(append([]any{}, p.egoDiags[uri]...), p.goDiags[uri]...)
	uri = p.editorURI(uri)
	p.mu.Unlock()
	p.editor.notify("textDocument/publishDiagnostics", map[string]any{"uri": uri, "diagnostics": all})
}

func (p *Proxy) egoDiag(uri string, d lower.Diagnostic) any {
	text := p.textOf(uri)
	start := Position{Line: max(d.Pos.Line-1, 0)}
	if text != nil && d.Pos.Line > 0 {
		start = text.position(text.lineStart(d.Pos.Line-1) + max(d.Pos.Column-1, 0))
	}
	end := start
	if text != nil {
		end = text.position(text.wordEnd(text.offset(start)))
	}
	return map[string]any{
		"range":    Range{Start: start, End: end},
		"severity": 1,
		"source":   "ego",
		"message":  d.Msg,
	}
}

func (p *Proxy) textOf(uri string) *text {
	p.mu.Lock()
	defer p.mu.Unlock()
	if d := p.egos[uri]; d != nil {
		return newText(d.text)
	}
	if b, err := os.ReadFile(uriToPath(uri)); err == nil {
		return newText(b)
	}
	return nil
}

// format formats a .ego document with ego fmt.
func (p *Proxy) format(m *message, key string) error {
	p.mu.Lock()
	d := p.egos[key]
	p.mu.Unlock()
	if d == nil {
		return p.editor.reply(m.ID, nil)
	}
	out, err := format.Source(d.text)
	if err != nil || string(out) == string(d.text) {
		return p.editor.reply(m.ID, []any{})
	}
	t := newText(d.text)
	edit := map[string]any{"range": Range{Start: Position{}, End: t.position(len(d.text))}, "newText": string(out)}
	return p.editor.reply(m.ID, []any{edit})
}

// fromGopls handles messages from gopls.
func (p *Proxy) fromGopls() error {
	for {
		m := check p.gopls.read() ""
		if err := p.safely(m, m.isResponse(), p.handleGopls); err != nil {
			p.logf("from gopls: %v", err)
		}
	}
}

func (p *Proxy) handleGopls(m *message) error {
	if m.isResponse() {
		p.mu.Lock()
		pd, ok := p.pending[string(m.ID)]
		delete(p.pending, string(m.ID))
		p.mu.Unlock()
		if !ok || len(m.Result) == 0 {
			return p.editor.write(m)
		}
		if pd.method == "initialize" {
			m.Result = adjustCapabilities(m.Result)
			return p.editor.write(m)
		}
		var v any
		check json.Unmarshal(m.Result, &v) ""
		if egos := p.unopened(v); len(egos) > 0 {
			return p.editor.replyError(m.ID, requestFailed, f"this changes {strings.Join(egos, ", ")} too, which the editor doesn't have open: open it, then try again")
		}
		v = p.fromGen(v, pd.gen, pd.gen)
		m.Result = check json.Marshal(v) ""
		return p.editor.write(m)
	}
	if m.Method == "textDocument/publishDiagnostics" {
		var params struct {
			URI         string           `json:"uri"`
			Diagnostics []map[string]any `json:"diagnostics"`
		}
		json.Unmarshal(m.Params, &params)
		gen := p.genOf(params.URI)
		if gen == nil {
			return nil // a .go file: the editor's own gopls reports it
		}
		var ds []any
		for _, d := range params.Diagnostics {
			if m := p.fromGen(d, gen, gen); m != nil {
				ds = append(ds, m) // a diagnostic in generated-only code has no .ego position
			}
		}
		p.mu.Lock()
		p.goDiags[gen.egoURI] = ds
		p.mu.Unlock()
		p.publish(gen.egoURI)
		return nil
	}
	return p.editor.write(m)
}

// adjustCapabilities advertises what this server supports for .ego files.
func adjustCapabilities(raw json.RawMessage) json.RawMessage {
	var r map[string]any
	if json.Unmarshal(raw, &r) != nil {
		return raw
	}
	caps, _ := r["capabilities"].(map[string]any)
	if caps == nil {
		caps = map[string]any{}
		r["capabilities"] = caps
	}
	caps["textDocumentSync"] = map[string]any{"openClose": true, "change": 1, "save": map[string]any{"includeText": false}}
	caps["documentFormattingProvider"] = true
	for _, k := range []string{"semanticTokensProvider", "inlayHintProvider", "codeLensProvider", "documentLinkProvider", "codeActionProvider", "documentRangeFormattingProvider", "foldingRangeProvider", "selectionRangeProvider", "callHierarchyProvider", "typeHierarchyProvider", "positionEncoding"} {
		delete(caps, k)
	}
	r["serverInfo"] = map[string]any{"name": "ego lsp"}
	out, _ := json.Marshal(r)
	return out
}

// toGen translates request params from a .ego document to its generated
// Go.
func (p *Proxy) toGen(raw json.RawMessage, egoText []byte, genURI string, gen *lower.Output) (json.RawMessage, error) {
	var v map[string]any
	check json.Unmarshal(raw, &v) ""
	src := newText(egoText)
	out := newText(gen.Raw)
	conv := func(pos any) any {
		var ps Position
		b, _ := json.Marshal(pos)
		json.Unmarshal(b, &ps)
		off, _ := gen.Map.ToOutput(src.offset(ps))
		return out.position(off)
	}
	if td, ok := v["textDocument"].(map[string]any); ok {
		td["uri"] = genURI
	}
	if pos, ok := v["position"]; ok {
		v["position"] = conv(pos)
	}
	if r, ok := v["range"].(map[string]any); ok {
		r["start"], r["end"] = conv(r["start"]), conv(r["end"])
	}
	return json.Marshal(v)
}

// unopened returns the .ego files whose generated Go an edit in a result
// changes, but whose source maps the proxy doesn't have, as the editor
// doesn't have them open: their edits can't be translated.
func (p *Proxy) unopened(v any) []string {
	edit, _ := v.(map[string]any)
	var uris []string
	if changes, ok := edit["changes"].(map[string]any); ok {
		for u := range changes {
			uris = append(uris, u)
		}
	}
	if dcs, ok := edit["documentChanges"].([]any); ok {
		for _, dc := range dcs {
			dc, _ := dc.(map[string]any)
			td, _ := dc["textDocument"].(map[string]any)
			if u, ok := td["uri"].(string); ok {
				uris = append(uris, u)
			}
		}
	}
	var egos []string
	for _, u := range uris {
		if p.genOf(u) != nil {
			continue
		}
		path := uriToPath(u)
		if src, ok := lower.GeneratedFrom(path); ok {
			if src == "" && filepath.Base(path) != "layers_ego.go" {
				src, _ = lower.SourceName(filepath.Base(path))
			}
			if src != "" {
				egos = append(egos, filepath.Join(filepath.Base(filepath.Dir(path)), src))
			}
		}
	}
	sort.Strings(egos)
	return egos
}

// fromGen translates positions in a result from generated Go back to .ego.
// req is the document the request was about; doc is the one that ranges
// without a URI of their own are in, nil for a Go file, whose ranges stay
// as they are. Edits (with newText) only keep text that maps exactly.
func (p *Proxy) fromGen(v any, req, doc *genDoc) any {
	switch v := v.(type) {
	case []any:
		out := v[:0]
		for _, e := range v {
			if e = p.fromGen(e, req, doc); e != nil {
				out = append(out, e)
			}
		}
		return out
	case map[string]any:
		_, edit := v["newText"]
		for _, k := range []string{"uri", "targetUri"} {
			if u, ok := v[k].(string); ok {
				doc = p.genOf(u)
				if doc != nil {
					v[k] = p.egoURIOf(doc)
				}
			}
		}
		if td, ok := v["textDocument"].(map[string]any); ok {
			if u, ok := td["uri"].(string); ok {
				doc = p.genOf(u)
				if doc != nil {
					td["uri"] = p.egoURIOf(doc)
					td["version"] = nil
				}
			}
		}
		if changes, ok := v["changes"].(map[string]any); ok {
			mapped := map[string]any{}
			for u, edits := range changes {
				if g := p.genOf(u); g != nil {
					mapped[p.egoURIOf(g)] = p.fromGen(edits, req, g)
				} else {
					mapped[u] = edits
				}
			}
			v["changes"] = mapped
		}
		for k, e := range v {
			switch k {
			case "range", "selectionRange", "targetRange", "targetSelectionRange", "insert", "replace":
				if doc == nil {
					continue
				}
				r, exact := p.mapRange(e, doc)
				if r == nil || edit && !exact {
					return nil
				}
				v[k] = r
			case "originSelectionRange":
				if r, _ := p.mapRange(e, req); r != nil {
					v[k] = r
				}
			case "additionalTextEdits":
				v[k] = p.additionalEdits(e, req, doc)
			case "changes", "uri", "targetUri", "textDocument":
			default:
				if m := p.fromGen(e, req, doc); m != nil || e == nil {
					v[k] = m
				} else {
					delete(v, k) // an edit that doesn't map
				}
			}
		}
		return v
	}
	return v
}

// egoURIOf returns the URI of a generated document's .ego file, as the
// editor writes it.
func (p *Proxy) egoURIOf(g *genDoc) string {
	p.mu.Lock()
	defer p.mu.Unlock()
	return p.editorURI(g.egoURI)
}

// mapRange maps a range in generated Go to the .ego file.
func (p *Proxy) mapRange(v any, gen *genDoc) (any, bool) {
	var r Range
	b, _ := json.Marshal(v)
	if json.Unmarshal(b, &r) != nil || gen == nil {
		return nil, false
	}
	p.mu.Lock()
	// The newest output: if a compilation finished after the request was
	// sent, gopls answered about an older version, and positions may be off
	// until the next answer.
	g := gen.out
	p.mu.Unlock()
	if g == nil {
		return nil, false
	}
	out, src := newText(g.Raw), newText(g.Src)
	a, ok1 := g.Map.ToSource(out.offset(r.Start))
	z, ok2 := g.Map.ToSource(out.offset(r.End))
	if !ok2 {
		z = a
	}
	if z < a {
		z = a
	}
	return Range{Start: src.position(a), End: src.position(z)}, ok1 && ok2
}

// Position and Range are LSP's, in UTF-16 code units.
type Position struct {
	Line      int `json:"line"`
	Character int `json:"character"`
}

type Range struct {
	Start Position `json:"start"`
	End   Position `json:"end"`
}

// text converts between byte offsets and LSP positions.
type text struct {
	src   []byte
	lines []int
}

func newText(src []byte) *text {
	t := &text{src: src, lines: []int{0}}
	for i, c := range src {
		if c == '\n' {
			t.lines = append(t.lines, i+1)
		}
	}
	return t
}

func (t *text) lineStart(line int) int {
	if line >= len(t.lines) {
		return len(t.src)
	}
	return t.lines[max(line, 0)]
}

func (t *text) offset(p Position) int {
	if p.Line >= len(t.lines) {
		return len(t.src)
	}
	off := t.lines[max(p.Line, 0)]
	for n := 0; n < p.Character && off < len(t.src) && t.src[off] != '\n'; {
		r, size := utf8.DecodeRune(t.src[off:])
		off += size
		n++
		if r >= 0x10000 {
			n++
		}
	}
	return off
}

func (t *text) position(off int) Position {
	off = min(max(off, 0), len(t.src))
	lo, hi := 0, len(t.lines)-1
	for lo < hi {
		mid := (lo + hi + 1) / 2
		if t.lines[mid] <= off {
			lo = mid
		} else {
			hi = mid - 1
		}
	}
	n := 0
	for i := t.lines[lo]; i < off; {
		r, size := utf8.DecodeRune(t.src[i:])
		i += size
		n++
		if r >= 0x10000 {
			n++
		}
	}
	return Position{Line: lo, Character: n}
}

// wordEnd returns the end of the identifier or token at off.
func (t *text) wordEnd(off int) int {
	i := off
	for i < len(t.src) {
		c := t.src[i]
		if c == '_' || c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= 0x80 {
			i++
			continue
		}
		break
	}
	if i == off && i < len(t.src) && t.src[i] != '\n' {
		i++
	}
	return i
}
