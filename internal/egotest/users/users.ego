package users

import (
	"context"
	"fmt"
	"net/http"
	"time"
)

type UserID string

type User struct {
	ID             UserID
	Name           string
	SuspendedUntil time.Time
}

type Repo interface {
	effect Find(id UserID) (u User, found bool, err error)
}

error UserError {
	NotFound{ ID UserID }
	Suspended{ Until time.Time }
	Storage{ Cause error }
}

type Service struct {
	Repo Repo
	Now  func() time.Time
}

effect (s *Service) Get(id UserID) (User, UserError) {
	u, ok := check s.Repo.Find(id) as Storage
	if !ok {
		fail NotFound{ID: id}
	}
	if u.SuspendedUntil.After(s.Now()) {
		fail Suspended{Until: u.SuspendedUntil}
	}
	return u, nil
}

type Handler struct{ Users *Service }

// GetUser is an effect method that stays an http.HandlerFunc: its ctx is
// r.Context(), and each request gets a span.
effect (h *Handler) GetUser(w http.ResponseWriter, r *http.Request) {
	u, err := h.Users.Get(UserID(r.PathValue("id")))
	match err {
		nil          => fmt.Fprintf(w, "%s\n", u.Name)
		NotFound(e)  => http.Error(w, f"no user {e.ID}", http.StatusNotFound)
		Suspended(e) => http.Error(w, f"suspended until {e.Until.Format(time.DateOnly)}", http.StatusForbidden)
		Storage(_)   => http.Error(w, "try again later", http.StatusServiceUnavailable)
	}
}

// GetAll loads users four at a time. Get's errors are passed on: they are
// the same set.
effect (s *Service) GetAll(ids []UserID) ([]User, UserError) {
	return each(ids, 4, id => s.Get(id))
}

// GetEach takes the method itself, which receives each call's ctx.
effect (s *Service) GetEach(ids []UserID) ([]User, error) {
	users := check each(ids, 2, s.Get) "get users"
	return users, nil
}

// AllExist runs a check that returns only an error on every id.
effect (s *Service) AllExist(ids []UserID) error {
	check each(ids, 8, id => s.exists(id))
	return nil
}

effect (s *Service) exists(id UserID) error {
	check s.Get(id)
	return nil
}

// Routes registers the handlers, one of them an effect literal.
func (h *Handler) Routes(mux *http.ServeMux) {
	mux.HandleFunc("GET /users/{id}", h.GetUser)
	mux.HandleFunc("GET /users/{id}/name", effect(w http.ResponseWriter, r *http.Request) {
		u := h.Users.Get(UserID(r.PathValue("id"))) else User{Name: "?"}
		fmt.Fprint(w, u.Name)
	})
}

// Lookup is shaped like a gRPC method: its ctx is its own parameter.
effect (s *Service) Lookup(ctx context.Context, id UserID) (string, error) {
	u := check s.Get(id)
	return u.Name, nil
}

// Names forks one lookup per id. The scope's literal gets its ctx from
// sc.Context(); the forked literals get a ctx parameter, as tasks need.
effect (s *Service) Names(ids []UserID) ([]string, error) {
	return scope.Run(ctx, effect(sc *scope.Scope) ([]string, error) {
		var fibers []*scope.Fiber[string]
		for _, id := range ids {
			fibers = append(fibers, scope.Fork(sc, effect() (string, error) { return s.Lookup(id) }))
		}
		var names []string
		for _, f := range fibers {
			name := check f.Join()
			names = append(names, name)
		}
		return names, nil
	})
}
