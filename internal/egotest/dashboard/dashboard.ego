// Package dashboard builds a user's home page from four services.
package dashboard

import (
	"errors"
	"time"

	"github.com/effect-go/effect-go/schedule"
)

type User struct {
	ID     string
	Name   string
	Banner string
}

type Order struct {
	ID    string
	Total int
}

type Product struct{ ID string }

type Image struct{ URL string }

type Page struct {
	User   User
	Orders []Order
	Recs   []Product
	Banner Image
}

type Deps struct {
	Users interface {
		effect Get(id string) (User, error)
	}
	Orders interface {
		effect ForUser(id string) ([]Order, error)
	}
	Recs interface {
		effect For(id string) ([]Product, error)
	}
	CDN interface {
		effect Primary(key string) (Image, error)
		effect Mirror(key string) (Image, error)
	}
}

// ErrRejected is a recommendation error that retrying won't fix.
var ErrRejected = errors.New("recommendations: request rejected")

var recsPolicy = schedule.Max(schedule.Exponential(100*time.Millisecond), schedule.Recurs(3)).
	Jittered().
	While(err => !errors.Is(err, ErrRejected))

// Load builds the page, giving up after two seconds.
effect Load(d Deps, id string) (Page, error) {
	return timeout(2*time.Second, load(d, id))
}

effect load(d Deps, id string) (Page, error) {
	user, orders, recs := check all(d.Users.Get(id), d.Orders.ForUser(id), retry(recsPolicy, d.Recs.For(id)))
	banner := check race(d.CDN.Primary(user.Banner), d.CDN.Mirror(user.Banner)) "banner"
	return Page{User: user, Orders: orders, Recs: recs, Banner: banner}, nil
}
