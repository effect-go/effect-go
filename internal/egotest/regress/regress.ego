// Package regress holds programs the compiler once got wrong, with the
// behavior a test checks.
package regress

import (
	"context"
	"io"
	"strconv"
	"strings"
	"sync/atomic"
	"time"
)

// CheckKeepsErr: check doesn't overwrite an err declared before it.
func CheckKeepsErr(a, b string) (int, error) {
	x, err := strconv.Atoi(a)
	y := check strconv.Atoi(b)
	if err != nil {
		return -1, err
	}
	return x + y, nil
}

// ElseKeepsErr: neither does else.
func ElseKeepsErr(a, b string) (int, error) {
	x, err := strconv.Atoi(a)
	y := strconv.Atoi(b) else 0
	if err != nil {
		return -1, err
	}
	return x + y, nil
}

// ElseKeepsNamedErr: nor a named err result.
func ElseKeepsNamedErr(b string) (n int, err error) {
	y := strconv.Atoi(b) else 7
	n = y
	return
}

// Percent: a % in a string with nothing interpolated stays one %.
func Percent() (string, error) {
	fail "disk 100% full"
}

// PercentF is the same with an f-string.
func PercentF() string { return f"100%" }

// Sentinel: a match on an error with only sentinel arms uses errors.Is.
func Sentinel(err error) string {
	return match err {
		nil    => "ok"
		io.EOF => "eof"
		_      => "other"
	}
}

type User struct{ Name string }

// OptAssign: x = u?.Name gives the zero value when u is nil.
func OptAssign(us []*User) []string {
	var out []string
	name := "unset"
	for _, u := range us {
		name = u?.Name
		out = append(out, name)
	}
	return out
}

// Article is what InTx fails with.
error ArticleError {
	Duplicate{ Slug string } "{Slug} exists"
	Unavailable{ Cause error }
}

// inTx runs fn as a transaction would: its error comes back as an error.
func inTx(fn func() error) error { return fn() }

// PassThrough: check … as Unavailable lets a case of the set through, from
// a call or a variable.
func PassThrough(slug string, variable bool) ArticleError {
	if variable {
		err := inTx(func() error { return Duplicate{Slug: slug} })
		check err as Unavailable
	}
	check inTx(func() error { return Duplicate{Slug: slug} }) as Unavailable
	check inTx(func() error { return io.EOF }) as Unavailable
	return nil
}

type Box struct{ N int }

// ShortCircuit: an if expression after && runs only when the left is true.
func ShortCircuit(p *Box) bool {
	ok := p != nil && (if p.N > 0 { true } else { false })
	return ok
}

// Order: operands run left to right, around a computed one: in a binary
// expression, a literal, an assignment, a return, and a method's receiver.
func Order() []string {
	var calls []string
	next := func(s string) int { calls = append(calls, s); return 1 }
	var m map[string]int
	x := next("left") + (if next("cond") > 0 { 1 } else { 2 })
	xs := []int{next("lit"), m["k"] ?? next("lit2")}
	a, b := next("as"), m["k"] ?? next("as2")
	pick := func(s string) func(int) int { next(s); return func(n int) int { return n } }
	pick("fun")(m["k"] ?? next("arg"))
	orderReturn(next, m)
	_, _, _, _ = x, xs, a, b
	return calls
}

func orderReturn(next func(string) int, m map[string]int) (int, int) {
	return next("ret"), m["k"] ?? next("ret2")
}

// Shadow: a match arm's names don't reach the later arms.
func Shadow(err error) string {
	ok := true
	e := "outer"
	return match err {
		Duplicate(e) => e.Slug
		_            => if ok { e } else { "shadowed" }
	}
}

// DivOneLine panics on a line that a stack trace must report as this one.
effect DivOneLine(m map[string]int) (int, error) { return m["a"] / len(m), nil } // one-line

type City string

type Player struct {
	Score float64
	Home  City
}

// OptFallback: p?.Score ?? 0 is a float64, and p?.Home ?? "none" a City.
func OptFallback(p *Player) (float64, City) {
	s := p?.Score ?? 0
	h := p?.Home ?? "none"
	return s, h
}

// FStringLoop: an f-string in a for condition.
func FStringLoop(b string) int {
	n := 0
	for f"{b}{n}" != "x2" {
		n++
	}
	return n
}

// Map is a generic function taking a callback.
func Map[T, R any](xs []T, f func(T) R) []R {
	var out []R
	for _, x := range xs {
		out = append(out, f(x))
	}
	return out
}

// MapS maps a slice of any slice type.
func MapS[S ~[]E, E, R any](xs S, f func(E) R) []R { return Map(xs, f) }

// Pair holds two values.
type Pair[K comparable, V any] struct {
	K K
	V V
}

// MapPair maps a pair's value.
func MapPair[K comparable, V, R any](p Pair[K, V], f func(V) R) Pair[K, R] {
	return Pair[K, R]{p.K, f(p.V)}
}

// Users is a named slice.
type Users []User

// GenericLambda: a lambda passed to Map gets its parameter types from the
// other arguments and gives Map its result type, typed or not.
func GenericLambda(us []User) ([]string, []string, []int, Pair[string, int]) {
	return Map(us, (u User) => u.Name), Map(us, u => u.Name), MapS(Users(us), u => len(u.Name)), MapPair(Pair[string, User]{"k", us[0]}, u => len(u.Name))
}

// LocalNames: variables named like the packages the generated code uses.
func LocalNames(s string) (int, ArticleError) {
	errors := []string{"a"}
	fmt := len(errors)
	n := check strconv.Atoi(s) as Unavailable
	return n + fmt, nil
}

// Counter has a method to call on a parenthesized receiver.
type Counter struct{ N string }

func (c *Counter) Value() (int, error) { return strconv.Atoi(c.N) }

// ParenReceiver: must and check before a parenthesized expression.
func ParenReceiver(s string) (int, error) {
	a := must (&Counter{N: "1"}).Value()
	b := check (&Counter{N: s}).Value() ""
	return a + b, nil
}

// CoalesceInLambda: ?? in a lambda whose parameter types come from the call.
func CoalesceInLambda(s string) string {
	swap := map[rune]rune{'a': 'b'}
	return strings.Map(r => swap[r] ?? r, s)
}

func apply(xs []int, f func(int)) {
	for _, x := range xs {
		f(x)
	}
}

// LambdaLift: what a lambda's ?? needs runs inside the lambda, with its
// parameter, not with a variable of the same name outside.
func LambdaLift(m map[int]string) []string {
	var out []string
	x := 0
	apply([]int{1, 2}, x => print(&out, m[x] ?? "none"))
	_ = x
	return out
}

func print(out *[]string, s string) { *out = append(*out, s) }

func failing(int) (int, error) { return 0, io.EOF }

// BranchLift: what a branch's ?? needs runs on every attempt of a retry,
// and in each's function.
effect BranchLift(m map[int]int, ids []int) (int, []int, error) {
	attempts := 0
	count := func() int { attempts++; return attempts }
	last := retry(schedule.Recurs(2), failing(m[0] ?? count())) else -1
	_ = last
	got := check each(ids, 2, id => strconv.Atoi(strconv.Itoa(m[id] ?? id)))
	return attempts, got, nil
}

// NestedLift: a combinator in another one is lowered once.
effect NestedLift(m map[int]int) (int, error) {
	a, b := check all(retry(schedule.Recurs(1), strconv.Atoi(strconv.Itoa(m[3] ?? 3))), timeout(time.Second, strconv.Atoi("4")))
	return a + b, nil
}

// Hidden: with :=, a check label, an else fallback and else arms mean the
// variable the declaration hides.
func Hidden(s string) (int, int, error) {
	port, n := 80, 7
	{
		port := strconv.Atoi(s) else port
		n := must strconv.Atoi(s) else { strconv.ErrSyntax => n }
		return port, n, parseHidden(s)
	}
}

func parseHidden(s string) error {
	if s != "" {
		s := check strconv.Atoi(s) "parse {s}"
		_ = s
	}
	return nil
}

// GeneratedNames: the err and ok the generated code declares don't hide
// the user's: an err from a select case or a lambda's parameter, an ok
// used in the arm that matched.
func GeneratedNames(errs chan error, ok bool) (string, string, string) {
	var fromSelect string
	select {
	case err := <-errs:
		n := must strconv.Atoi("1")
		fromSelect = f"{err} {n}"
	}
	var f func(error) string = err => {
		n := must strconv.Atoi("2")
		return f"{err} {n}"
	}
	arm := match error(Duplicate{Slug: "a"}) {
		nil          => "nil"
		Duplicate(_) => if ok { "ok" } else { "not ok" }
		_            => "other"
	}
	return fromSelect, f(io.EOF), arm
}

// TargetOnce: the target of x = a ?? b is evaluated once.
func TargetOnce(p *int) ([]*int, int) {
	ps := make([]*int, 3)
	calls := 0
	next := func() int { calls++; return calls }
	def := 7
	ps[next()] = p ?? &def
	return ps, calls
}

// Span is a type named like the variable an effect function's span goes in.
type Span struct{ W int }

// Clashes: code that once clashed with what the compiler generates: an err
// declared again with a variable declared before, a parameter named span,
// and arms that need no errors package.
effect Clashes(span Span, s string) (int, error) {
	n := 0
	n, err := strconv.Atoi(s)
	if err != nil {
		n = strconv.Atoi(s) else { _ => -1 }
	}
	return n + span.W, nil
}

// Untyped: constants in conditional values get the type their context
// expects, not int.
func Untyped(c bool) (float64, time.Duration) {
	d := (if c { 100 } else { 200 }) * time.Millisecond
	var f float64 = 0
	f += if c { 1 } else { 2 }
	f = 2*f + untypedReturn(c)
	return f, d
}

func untypedReturn(c bool) float64 { return if c { 1 } else { 0 } }

// Labeled: what a labeled loop's header needs goes before the label.
func Labeled(m map[string][]int, xs []int) int {
	n := 0
outer:
	for _, x := range m["a"] ?? xs {
		for range 2 {
			if x > 1 {
				continue outer
			}
		}
		n += x
	}
	return n
}

// Address has tags, behind a pointer.
type Address struct{ Tags map[string]string }

// Missing: ?? falls back on a nil or a miss, through a ?. chain too.
func Missing(a *Address, m map[string]*int, x any) (string, int, int) {
	tag := a?.Tags["k"] ?? "none"
	def := -1
	n := m["k"] ?? &def
	p := x.(*int) ?? &def
	return tag, *n, *p
}

// Shelf removes items, failing on negative ones.
type Shelf struct{ removed atomic.Int64 }

// Remove returns only an error.
effect (s *Shelf) Remove(n int) error {
	if n < 0 {
		fail Moved{Slug: "n", Times: n}
	}
	s.removed.Add(int64(n))
	return nil
}

// RemoveAll passes a method returning only an error to each.
effect (s *Shelf) RemoveAll(ns []int) (int64, error) {
	check each(ns, 2, s.Remove)
	return s.removed.Load(), nil
}

// Move has case messages with expressions and raw strings.
error MoveError {
	Moved {
		Slug  string
		Times int
	} "{Slug} moved {Times + 1} times"
	Gone{ Slug string } `"{Slug}" is gone`
}

// Formatter: a lambda in a branch takes its types from the variable.
func Formatter(loud bool, k int) (string, string) {
	var f func(int) string = if loud { n => f"{n}!" } else { n => f"{n}" }
	var g func(int) string
	g = match k { 1 => n => f"one {n}"; _ => n => "other" }
	return f(1), g(2)
}

// ctxValue reads a value from ctx.
func ctxValue(ctx context.Context) (string, error) { return ctx.Value(ctxKey{}).(string), nil }

type ctxKey struct{}

// Immediate calls an effect literal at once: it gets ctx.
effect Immediate() (string, error) {
	v := check effect() (string, error) { return ctxValue() }()
	return v, nil
}
