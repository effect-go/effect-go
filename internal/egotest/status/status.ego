package status

import (
	"errors"
	"math"
	"net/http"
	"strconv"
)

error PayError {
	Declined{ Reason string } "declined: {Reason}"
	Expired{}
	Gateway{ Cause error }
}

// Code maps a payment's result to an HTTP status. err is declared as a
// PayError, so the match needs no _ arm.
func Code(err PayError) int {
	code := match err {
		nil         => http.StatusOK
		Declined(_) => http.StatusPaymentRequired
		Expired(_)  => http.StatusGone
		Gateway(_)  => http.StatusBadGateway
	}
	return code
}

func Describe(err error) string {
	return match err {
		nil         => "ok"
		Declined(d) => d.Reason
		_           => "failed: " + err.Error()
	}
}

func Charge(amount int) (string, PayError) {
	if amount <= 0 {
		fail Declined{Reason: "nothing to charge"}
	}
	if amount > 100 {
		fail Gateway{Cause: errors.New("timeout")}
	}
	return "ok", nil
}

// Amount parses an amount. A bad one is Declined, with its own message.
func Amount(s string) (int, PayError) {
	n := check strconv.Atoi(s) as Declined{Reason: f"bad amount {s:q}"}
	return n, nil
}

// Remote keeps the cause: Gateway's error field gets it.
func Remote(s string) (int, PayError) {
	n := check strconv.Atoi(s) as Gateway{}
	return n, nil
}

// Pay passes Charge's errors on unchanged: they are the same set.
func Pay(amount int) (string, PayError) {
	r := check Charge(amount)
	return r, nil
}

// Settle recovers from a declined charge and returns the other errors,
// labelled.
func Settle(amount int) (string, error) {
	r := check Charge(amount) "settle {amount}" else { Declined(d) => f"skipped: {d.Reason}" }
	return r, nil
}

// State handles every case of the set, so it needs no check.
func State(amount int) (s string) {
	s = Charge(amount) else { Declined(_) => "declined"; Expired(_), Gateway(_) => "retry later" }
	return s
}

// Clamp saturates numbers out of range: strconv.ErrRange is found inside
// the *strconv.NumError that wraps it.
func Clamp(s string) (int, error) {
	n := check strconv.Atoi(s) else { strconv.ErrRange => math.MaxInt }
	return n, nil
}
