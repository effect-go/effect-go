package basics

import "errors"

error E {
	A{ Cause error }
	B{}
}

type Other struct{}

func (Other) Error() string { return "other" }

func load() (int, error) { return 0, errors.New("x") }

func noErr() int {
	x := check load() // ERROR "check needs a function that returns an error"
	return x
}

func set() (int, E) {
	x := check load() // ERROR "returns E: write check … as <case>"
	fail Other{} // ERROR "Other is not a case of E"
}

func noCause() (int, E) {
	x := check load() as B // ERROR "B has no error field to hold the cause: give its fields"
	return x, nil
}

func positional() (int, E) {
	x := check load() as A{nil} // ERROR "name the fields of A"
	return x, nil
}

func inner() (int, error) {
	return check load() + 1, nil // ERROR "check must start a statement"
}

func handle(err error) {
	match err { // ERROR "doesn't handle B"
		nil  => println("ok")
		A(_) => println("a")
	}
}

func header() int {
	if v := load() else 0; v > 0 { // ERROR "check can't be used in an if header"
		return v
	}
	return 0
}

func lam() {
	f := x => x // ERROR "can't tell the parameter types"
	_ = f
	g := (x int) => { return x } // ERROR "can't tell the result types"
	_ = g
}

effect withCtx(ctx int) error { // ERROR "ctx is the context: rename this parameter"
	return nil
}

func loadE() (int, E) { return 0, nil }

func elseArms() (int, error) {
	a := loadE() else { A(_) => 1 } // ERROR "match on E doesn't handle B"
	b := load() else { errors.ErrUnsupported => 2 } // ERROR "these arms don't cover every error"
	c := check load() else 3 // ERROR "else with a fallback handles every error, so there is nothing to check"
	d := check load() else { nil => 4 } // ERROR "an else arm can't match nil"
	return a + b + c + d, nil
}

func one(int) (int, error) { return 0, nil }

func eachNoCtx(ids []int) error {
	check each(ids, 2, id => one(id)) // ERROR "each needs a ctx"
	return nil
}

effect eachShapes(ids []int) error {
	check each(ids, 2, (a, b) => one(a)) // ERROR "each takes a function of one item"
	check each(ids, 2) // ERROR "each takes three arguments"
	return nil
}

effect errResult() error {
	_, err := load()
	if err != nil {
		return err
	}
	var err error // ERROR "err is already this effect function's error result"
	return err
}
