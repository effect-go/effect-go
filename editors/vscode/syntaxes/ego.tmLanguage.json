{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "effect-go",
  "scopeName": "source.ego",
  "patterns": [
    {
      "include": "source.go"
    }
  ],
  "injections": {
    "L:source.ego - string - comment": {
      "comment": "Inside Go's own regions too (function bodies, parentheses), where source.go only applies its own rules",
      "patterns": [
        {
          "include": "#dialect"
        }
      ]
    }
  },
  "repository": {
    "fstring": {
      "begin": "\\bf\"",
      "end": "\"",
      "name": "string.quoted.double.ego",
      "patterns": [
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.ego"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.ego"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.interpolation.ego",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.ego"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.ego"
            }
          },
          "contentName": "source.go",
          "patterns": [
            {
              "comment": "an expression with a format spec: {n:.2f}, {s:q}, {id:-3d}. Matched whole, or Go's key: rule takes the colon",
              "match": "([^{}:\"]*?)(:[-+# 0]*\\d*(?:\\.\\d+)?[a-zA-Z%]?)(?=\\})",
              "captures": {
                "1": {
                  "patterns": [
                    {
                      "include": "source.go"
                    }
                  ]
                },
                "2": {
                  "name": "constant.other.placeholder.ego"
                }
              }
            },
            {
              "include": "source.go"
            }
          ]
        }
      ]
    },
    "dialect": {
      "patterns": [
        {
          "include": "#fstring"
        },
        {
          "comment": "effect declarations: effect Name( and effect (recv) Name(",
          "match": "^\\s*(effect)\\b(?=\\s*[\\w(])",
          "captures": {
            "1": {
              "name": "keyword.function.ego"
            }
          }
        },
        {
          "comment": "error sets and enums: error Name { and enum Name {",
          "match": "^\\s*(error|enum)\\s+([A-Za-z_]\\w*)\\s*(?=\\{)",
          "captures": {
            "1": {
              "name": "keyword.type.ego"
            },
            "2": {
              "name": "entity.name.type.ego"
            }
          }
        },
        {
          "match": "\\b(check|must)\\b(?=\\s+[A-Za-z_])",
          "name": "keyword.control.ego"
        },
        {
          "match": "\\b(fail)\\b(?=\\s+[\\w\"&])",
          "name": "keyword.control.ego"
        },
        {
          "match": "\\b(match)\\b(?=\\s+[A-Za-z_])",
          "name": "keyword.control.ego"
        },
        {
          "match": "\\b(as)\\b(?=\\s+[A-Z])",
          "name": "keyword.control.ego"
        },
        {
          "match": "\\b(all|race|retry|repeat|timeout|each)\\b(?=\\()",
          "name": "support.function.builtin.ego"
        },
        {
          "match": "=>|\\?\\.|\\?\\?",
          "name": "keyword.operator.ego"
        }
      ]
    }
  }
}
